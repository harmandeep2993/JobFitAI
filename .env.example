# Copy this file to backend/.env and fill in your values.
# Never commit backend/.env - it is gitignored.
#
# Every secret below is server-side only. The frontend reads NO environment
# variables at all: nothing here is ever bundled into the browser.

# === Required ===
# Signs JWT auth tokens. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
# Startup fails when APP_ENV=production and this is unset.
JWT_SECRET=

# LLM providers (OpenAI is the default; Groq is the automatic fallback)
OPENAI_API_KEY=
GROQ_API_KEY=

# Adzuna job board credentials (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# === Access control ===
# Comma-separated emails granted the admin role (app-wide LLM settings switch)
ADMIN_EMAILS=

# When set, registration requires this code (invite-only beta). Unset = open registration.
INVITE_CODE=

# === Production only ===
# Set to "production" to enforce production requirements (startup fails without JWT_SECRET)
# APP_ENV=production

# Comma-separated CORS origins; defaults to the localhost dev servers when unset.
# Set this to your real domain in production - a permissive origin with
# credentials enabled would let any site ride an authenticated session.
# ALLOWED_ORIGINS=https://yourdomain.com

# Cloud SQLite (optional - falls back to local data/jobsfitai.db when unset).
# Both must be set to activate Turso.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# === Optional: single-user password gate ===
# Legacy alternative to JWT accounts - puts a basic username/password wall in
# front of the whole app. Leave APP_PASSWORD unset to use normal JWT auth.
# SESSION_SECRET signs the session cookie; without it, a random secret is
# generated per process and everyone is logged out on restart.
# APP_USERNAME=admin
# APP_PASSWORD=
# SESSION_SECRET=
